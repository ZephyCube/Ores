{
    "format_version": "1.21.90",
    "minecraft:item": {
        "description": {
            "identifier": "simple_hammers:iron_hammer",
            "menu_category": {
                "category": "equipment",
                "group": "simple_hammers:itemGroup.name.hammers"
            }
        },
        "components": {
            "minecraft:display_name": {
                "value": "%item.simple_hammers.iron_hammer\n§7%tooltip.simple_hammers§r"
            },
            "minecraft:icon": "simple_iron_hammer",
            "simple_hammers:on_break":{
                "includeTags": ["iron_pick_diggable", "stone", "rail", "minecraft:iron_tier_destructible", "minecraft:is_pickaxe_item_destructible"],
                "excludeTags": ["minecraft:diamond_tier_destructible","mob_spawner"]
            },
            "minecraft:hand_equipped": true,
            "minecraft:max_stack_size": 1,
            "minecraft:durability": {
                "damage_chance": {
                    "min": 1,
                    "max": 1
                },
                "max_durability": 624
            },
            "minecraft:enchantable": {
                "slot": "pickaxe",
                "value": 14
            },
            "minecraft:repairable": {
                "repair_items": [
                    {
                        "items": ["minecraft:iron_ingot"],
                        "repair_amount": "q.max_durability * 0.2"
                    },
                    {
                        "items": ["simple_hammers:iron_hammer"],
                        "repair_amount": "c.other->q.remaining_durability * 0.8"
                    }
                ]
            },
            "minecraft:damage": {
                "value": 5
            },
            "minecraft:tags": {
                "tags": ["minecraft:is_pickaxe","minecraft:iron_tier"]
            },
            "minecraft:digger": {
                "use_efficiency": true,
                "destroy_speeds": [
                    {
                        "block": {
                            "tags": "query.any_tag( 'stone', 'minecraft:is_pickaxe_item_destructible' ) && !query.any_tag('minecraft:diamond_tier_destructible')"
                        },
                        "speed": 7
                    }
                ]
            }
        }
    }
}